# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
backend/.env
frontend/.env

# Production Builds & Output
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Uploaded Files & Temporary Assets
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
test-upload.txt
*.local

# Local Database Runtime File (keep schema, ignore dynamic runtime JSON)
backend/database.json

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

