# ==============================================================================
# AuraClass Frontend Environment Variables
# ==============================================================================

# Base URL pointing to the deployed Express backend API
# (Must start with VITE_ to be exposed to client-side code in Vite)

# Local Development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production Deployment Example (e.g. Render, Railway, Vercel, AWS):
# VITE_API_BASE_URL=https://your-deployed-backend.onrender.com/api
